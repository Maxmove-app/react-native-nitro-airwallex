root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.kt]
indent_size = 4
ktlint_code_style = ktlint_official
# Converter filenames mirror the native API type and operation (Type+operation.kt).
ktlint_standard_filename = disabled
